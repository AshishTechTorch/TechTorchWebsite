PORT=5000
NODE_ENV=production
# Frontend URL(s), comma separated, no trailing slash
CLIENT_URL=https://your-frontend-domain.com
MONGO_URI=
JWT_SECRET=
# Zoho SMTP (password-reset emails). Use an app password, not your login password
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
# Only if frontend and backend are on different domains (needs HTTPS)
# COOKIE_SAMESITE=none
# Only for: node createSuperadmin.js
# SUPERADMIN_NAME=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
